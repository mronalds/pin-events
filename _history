: void {\n        pins.setEvents(pin, PinEventType.Pulse)\n    }\n\n    /**\n     * Unlocks all primary safe digital pins (P0, P1, P2, P8, P13, P14, P15, P16) at once.\n     */\n    //% block=\"enable broadcasting on ALL pins\"\n    export function enableAllPinsBroadcasting(): void {\n        const safePins = [\n            DigitalPin.P0, DigitalPin.P1, DigitalPin.P2,\n            DigitalPin.P8, DigitalPin.P13, DigitalPin.P14,\n            DigitalPin.P15, DigitalPin.P16\n        ];\n        for (let pin of safePins) {\n            pins.setEvents(pin, PinEventType.Pulse)\n        }\n    }\n}\n"}]},{"timestamp":1790244892767,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":278,"length1":217,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]},{"timestamp":1790245199388,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":159,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_forever\" x=\"0\" y=\"0\"></block></xml>"]]}]}]}],"snapshots":[{"timestamp":1790244075880,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"custom \",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1790245280460}